<Window x:Class="PunchClock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PunchClock"
        Width="640" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Time}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Date}" FontSize="18" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,24,0,4" Text="Employee" />
        <ComboBox Grid.Row="2"
                  FontSize="18"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  DisplayMemberPath="FullName" />

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,4" Text="PIN" />
            <PasswordBox x:Name="PinBox" FontSize="18" MaxLength="8" PasswordChanged="OnPinChanged" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Punch In" Command="{Binding PunchInCommand}" Margin="0,0,16,0" />
            <Button Content="Punch Out" Command="{Binding PunchOutCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Margin="0,24,0,0"
                   Text="{Binding Message}"
                   FontSize="16"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </Grid>
</Window>
