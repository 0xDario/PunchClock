<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PunchClock.Data.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logical names are stable regardless of folder casing: Migrations/0001_initial.sql -> 0001_initial.sql -->
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="PunchClock.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PunchClock.Core\PunchClock.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PunchClock.Tests" />
  </ItemGroup>

</Project>
