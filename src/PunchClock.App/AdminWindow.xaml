<Window x:Class="PunchClock.App.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PunchClock administration" Width="820" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontSize="14">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Sign _out" Click="SignOut_Click" Padding="12,4" />
            <Button DockPanel.Dock="Right" Content="Change my _password" Click="ChangeMyPassword_Click" Padding="12,4" Margin="0,0,8,0" />
            <TextBlock x:Name="SignedInAs" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" />

        <TabControl>
            <TabItem x:Name="SiteTab" Header="_Site">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Punches store UTC plus this zone's offset at the moment of the punch. Changing the zone affects new punches only." />
                    <Label Content="Site _time zone" Target="{Binding ElementName=TimeZoneBox}" Padding="0,0,0,4" />
                    <ComboBox x:Name="TimeZoneBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Padding="6" />
                    <TextBlock x:Name="CurrentZone" Foreground="Gray" Margin="0,6,0,0" />
                    <Button Content="Save _time zone" Click="SaveTimeZone_Click" HorizontalAlignment="Left" Padding="12,4" Margin="0,12,0,0" />

                    <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray"
                               Text="Saves a complete copy of the database, checks it, and records it in the audit log. Keep copies off this PC: they hold every PIN and password hash." />
                    <Button Content="_Back up database..." Click="Backup_Click" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0" />
                    <TextBlock x:Name="BackupResult" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="Records to review" FontWeight="SemiBold" Margin="0,24,0,4" />
                    <TextBlock x:Name="WarningSummary" TextWrapping="Wrap" Foreground="Gray" />
                    <ListBox x:Name="WarningList" MaxHeight="140" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AccountsTab" Header="_Accounts">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="Selected account" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="AccountReason" Padding="6" Text="Legacy import finished" ToolTip="Reason (kept in the audit log)" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="_Deactivate" Click="DeactivateAccount_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Re_activate" Click="ActivateAccount_Click" Padding="12,4" Margin="0,0,8,0" />
                            <ComboBox x:Name="AccountLinkEmployee" Grid.Column="2" DisplayMemberPath="Label" Padding="6" Margin="0,0,8,0"
                                      ToolTip="Employee this person also punches as" />
                            <Button Grid.Column="3" Content="Set _link" Click="SetAccountLink_Click" Padding="12,4" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AccountResetPassword" Grid.Column="0" Padding="6" Margin="0,0,8,0" ToolTip="Temporary password (10+ characters)" />
                            <Button Grid.Column="1" Content="Reset pass_word" Click="ResetAccountPassword_Click" Padding="12,4" />
                        </Grid>
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Reason, then deactivate, link to the employee this person punches as (they cannot correct their own punches), or set a temporary password they must replace at sign-in." />
                        <TextBlock Text="Add account" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewAccountUsername" Grid.Column="0" Padding="6" Margin="0,0,8,0" ToolTip="Username" />
                            <TextBox x:Name="NewAccountName" Grid.Column="1" Padding="6" Margin="0,0,8,0" ToolTip="Full name" />
                            <ComboBox x:Name="NewAccountRole" Grid.Column="2" Padding="6" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Role">
                                <ComboBoxItem Content="Manager" />
                                <ComboBoxItem Content="Admin" />
                            </ComboBox>
                            <PasswordBox x:Name="NewAccountPassword" Grid.Column="3" Padding="6" Margin="0,0,8,0" ToolTip="Temporary password (10+ characters)" />
                            <ComboBox x:Name="NewAccountEmployee" Grid.Column="4" DisplayMemberPath="Label" Padding="6" Margin="0,0,8,0"
                                      ToolTip="Employee this person also punches as" />
                            <Button Grid.Column="5" Content="Add" Click="AddAccount_Click" Padding="12,4" />
                        </Grid>
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Username, full name, role, temporary password, employee link. Give each person their own account so the audit log shows who made each change." />
                    </StackPanel>
                    <ListView x:Name="AccountList" SelectionChanged="AccountList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Username" DisplayMemberBinding="{Binding User.Username}" Width="130" />
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding User.DisplayName}" Width="150" />
                                <GridViewColumn Header="Role" DisplayMemberBinding="{Binding User.Role}" Width="80" />
                                <GridViewColumn Header="Active" DisplayMemberBinding="{Binding User.IsActive}" Width="60" />
                                <GridViewColumn Header="Punches as" DisplayMemberBinding="{Binding Employee}" Width="150" />
                                <GridViewColumn Header="Password change due" DisplayMemberBinding="{Binding User.MustChangePassword}" Width="150" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="EmployeesTab" Header="_Employees">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="_Deactivate" Click="DeactivateEmployee_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Re_activate" Click="ActivateEmployee_Click" Padding="12,4" />
                        </StackPanel>
                        <TextBlock Text="Reset a forgotten PIN" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TemporaryPin" Grid.Column="0" MaxLength="6" Padding="6" Margin="0,0,8,0" ToolTip="Temporary PIN (3-6 digits)"
                                         PreviewTextInput="Pin_PreviewTextInput" DataObject.Pasting="Pin_Pasting" />
                            <TextBox x:Name="PinResetReason" Grid.Column="1" Padding="6" Margin="0,0,8,0" Text="Forgot PIN" ToolTip="Reason (kept in the audit log)" />
                            <Button Grid.Column="2" Content="Reset P_IN" Click="ResetPin_Click" Padding="12,4" />
                        </Grid>
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Temporary PIN, reason. The employee must choose a new PIN before their next punch is recorded." />
                        <TextBlock Text="Add employee" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewFirstName" Grid.Column="0" Padding="6" Margin="0,0,8,0" ToolTip="First name" />
                            <TextBox x:Name="NewLastName" Grid.Column="1" Padding="6" Margin="0,0,8,0" ToolTip="Last name" />
                            <PasswordBox x:Name="NewPin" Grid.Column="2" MaxLength="6" Padding="6" Margin="0,0,8,0" ToolTip="Starting PIN (3-6 digits)"
                                         PreviewTextInput="Pin_PreviewTextInput" DataObject.Pasting="Pin_Pasting" />
                            <Button Grid.Column="3" Content="Add" Click="AddEmployee_Click" Padding="12,4" />
                        </Grid>
                        <TextBlock Foreground="Gray" Text="First name, last name, starting PIN. The employee must replace the starting PIN before their first punch is recorded." TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListView x:Name="EmployeeList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding DisplayName}" Width="240" />
                                <GridViewColumn Header="Active" DisplayMemberBinding="{Binding IsActive}" Width="70" />
                                <GridViewColumn Header="PIN reset due" DisplayMemberBinding="{Binding PinMustChange}" Width="110" />
                                <GridViewColumn Header="Legacy ID" DisplayMemberBinding="{Binding LegacyId}" Width="90" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="CorrectionsTab" Header="_Corrections">
                <DockPanel Margin="16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CorrectionEmployee" Grid.Column="0" DisplayMemberPath="DisplayName" Padding="6" Margin="0,0,8,0"
                                  ToolTip="Employee" SelectionChanged="CorrectionFilter_Changed" />
                        <DatePicker x:Name="CorrectionFrom" Grid.Column="1" Margin="0,0,8,0" ToolTip="From (site date)" SelectedDateChanged="CorrectionFilter_Changed" />
                        <DatePicker x:Name="CorrectionTo" Grid.Column="2" Margin="0,0,8,0" ToolTip="To (site date, inclusive)" SelectedDateChanged="CorrectionFilter_Changed" />
                        <Button Grid.Column="3" Content="_Show" Click="ShowPunches_Click" Padding="12,4" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CorrectionDirection" Grid.Column="0" Padding="6" Margin="0,0,8,0" SelectedIndex="0" ToolTip="Direction">
                                <ComboBoxItem Content="In" />
                                <ComboBoxItem Content="Out" />
                            </ComboBox>
                            <DatePicker x:Name="CorrectionDate" Grid.Column="1" Margin="0,0,8,0" ToolTip="Date (site time)" />
                            <TextBox x:Name="CorrectionTime" Grid.Column="2" Padding="6" Margin="0,0,8,0" ToolTip="Time (site time), e.g. 17:30" />
                            <TextBox x:Name="CorrectionReason" Grid.Column="3" Padding="6" ToolTip="Reason, at least 10 characters (kept in the audit log)" />
                        </Grid>
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="Direction, date and time in the site time zone, reason. Corrections never erase a punch: the original stays in the audit log." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add _missing punch" Click="AddPunch_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="C_hange selected" Click="AdjustPunch_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="_Void selected" Click="VoidPunch_Click" Padding="12,4" />
                        </StackPanel>
                    </StackPanel>
                    <ListView x:Name="PunchList" SelectionChanged="PunchList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Site time" DisplayMemberBinding="{Binding Punch.OccurredAtLocal, StringFormat='ddd yyyy-MM-dd HH:mm:ss'}" Width="190" />
                                <GridViewColumn Header="Direction" DisplayMemberBinding="{Binding Punch.Direction}" Width="80" />
                                <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Punch.Source}" Width="110" />
                                <GridViewColumn Header="Issue" DisplayMemberBinding="{Binding Issue}" Width="160" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ReportsTab" Header="_Reports">
                <DockPanel Margin="16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="ReportFrom" Grid.Column="0" Margin="0,0,8,0" ToolTip="First day of the pay period (site date)" />
                        <DatePicker x:Name="ReportTo" Grid.Column="1" Margin="0,0,8,0" ToolTip="Last day of the pay period (site date, inclusive)" />
                        <Button Grid.Column="2" Content="R_un report" Click="RunReport_Click" Padding="12,4" />
                        <TextBlock x:Name="ReportTotal" Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Hours follow the old app's report: a shift counts in the period it starts in, if it also ends before the period does. Minutes are counted on the wall clock, so a shift across a daylight-saving change shows its elapsed hours separately. Every export is recorded in the audit log with the file's fingerprint." />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export _pay report CSV..." Click="ExportPayReport_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Export pu_nches CSV..." Click="ExportPunches_Click" Padding="12,4" Margin="0,0,8,0" />
                            <Button Content="Export c_orrections CSV..." Click="ExportCorrections_Click" Padding="12,4" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="PayLines" Grid.Row="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Employee" DisplayMemberBinding="{Binding Name}" Width="200" />
                                    <GridViewColumn Header="Legacy ID" DisplayMemberBinding="{Binding LegacyId}" Width="80" />
                                    <GridViewColumn Header="Shifts" DisplayMemberBinding="{Binding Shifts}" Width="60" />
                                    <GridViewColumn Header="Hours" DisplayMemberBinding="{Binding Hours, StringFormat='0.00'}" Width="70" />
                                    <GridViewColumn Header="Elapsed hours" DisplayMemberBinding="{Binding ElapsedHours, StringFormat='0.00'}" Width="110" />
                                    <GridViewColumn Header="Not counted" DisplayMemberBinding="{Binding NotCounted}" Width="100" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="Shifts not counted in this period" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <ListView x:Name="UncountedShifts" Grid.Row="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Employee" DisplayMemberBinding="{Binding Name}" Width="170" />
                                    <GridViewColumn Header="In" DisplayMemberBinding="{Binding InLocal, StringFormat='ddd yyyy-MM-dd HH:mm'}" Width="160" />
                                    <GridViewColumn Header="Out" DisplayMemberBinding="{Binding OutLocal, StringFormat='ddd yyyy-MM-dd HH:mm'}" Width="160" />
                                    <GridViewColumn Header="Why" DisplayMemberBinding="{Binding Reason}" Width="360" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
