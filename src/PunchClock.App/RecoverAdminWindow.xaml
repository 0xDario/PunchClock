<Window x:Class="PunchClock.App.RecoverAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover an admin account" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <StackPanel Margin="24">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Label Content="_Admin account" Target="{Binding ElementName=Account}" Padding="0,0,0,4" />
        <ComboBox x:Name="Account" DisplayMemberPath="Label" Padding="6" Margin="0,0,0,12" />
        <Label Content="_Reason (kept in the audit log)" Target="{Binding ElementName=Reason}" Padding="0,0,0,4" />
        <TextBox x:Name="Reason" Padding="6" Margin="0,0,0,12" />
        <Label Content="_Temporary password (10+ characters)" Target="{Binding ElementName=Password}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Password" Padding="6" Margin="0,0,0,12" />
        <Label Content="Re_peat temporary password" Target="{Binding ElementName=RepeatPassword}" Padding="0,0,0,4" />
        <PasswordBox x:Name="RepeatPassword" Padding="6" />
        <TextBlock x:Name="Error" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button x:Name="RecoverButton" Content="_Set temporary password" IsDefault="True" Click="Recover_Click" Padding="14,6" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
