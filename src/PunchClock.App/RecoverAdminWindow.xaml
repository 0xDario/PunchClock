<Window x:Class="PunchClock.App.RecoverAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover an admin account" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <StackPanel Margin="24">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Use this when no admin can sign in. The PunchClock owner signs the challenge below with their owner key, and the response they send back lets you set a temporary password. Its owner must choose a new password at their next sign-in. The audit log keeps the challenge, the owner key and your reason." />
        <Label Content="_Admin account" Target="{Binding ElementName=Account}" Padding="0,0,0,4" />
        <ComboBox x:Name="Account" DisplayMemberPath="Label" Padding="6" Margin="0,0,0,12" SelectionChanged="Account_SelectionChanged" />
        <Label Content="_Challenge: send this to the PunchClock owner" Target="{Binding ElementName=Challenge}" Padding="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Challenge" IsReadOnly="True" FontFamily="Consolas" Padding="6" />
            <Button x:Name="CopyButton" Grid.Column="1" Content="C_opy" Click="Copy_Click" Padding="12,6" Margin="8,0,0,0" IsEnabled="False" />
        </Grid>
        <TextBlock x:Name="ChallengeNote" TextWrapping="Wrap" Foreground="#555555" FontSize="13" Margin="0,0,0,12"
                   Text="Choose the account first. The challenge works for 60 minutes and only while this window stays open." />
        <Label Content="_Response from the owner" Target="{Binding ElementName=Response}" Padding="0,0,0,4" />
        <TextBox x:Name="Response" FontFamily="Consolas" Padding="6" Margin="0,0,0,12" TextWrapping="Wrap" MinLines="2" AcceptsReturn="False" />
        <Label Content="_Reason (kept in the audit log)" Target="{Binding ElementName=Reason}" Padding="0,0,0,4" />
        <TextBox x:Name="Reason" Padding="6" Margin="0,0,0,12" />
        <Label Content="_Temporary password (10+ characters)" Target="{Binding ElementName=Password}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Password" Padding="6" Margin="0,0,0,12" />
        <Label Content="Re_peat temporary password" Target="{Binding ElementName=RepeatPassword}" Padding="0,0,0,4" />
        <PasswordBox x:Name="RepeatPassword" Padding="6" />
        <TextBlock x:Name="Error" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button x:Name="RecoverButton" Content="_Set temporary password" IsDefault="True" Click="Recover_Click" Padding="14,6" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
