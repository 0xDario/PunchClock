<Window x:Class="PunchClock.App.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin sign-in" Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <StackPanel Margin="24">
        <Label Content="_Username" Target="{Binding ElementName=Username}" Padding="0,0,0,4" />
        <TextBox x:Name="Username" Padding="6" Margin="0,0,0,12" />
        <Label Content="_Password" Target="{Binding ElementName=Password}" Padding="0,0,0,4" />
        <PasswordBox x:Name="Password" Padding="6" />
        <TextBlock x:Name="Error" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button x:Name="SignInButton" Content="_Sign in" IsDefault="True" Click="SignIn_Click" Padding="14,6" />
        </StackPanel>
    </StackPanel>
</Window>
