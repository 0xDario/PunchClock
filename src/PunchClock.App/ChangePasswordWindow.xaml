<Window x:Class="PunchClock.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change your password" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="15">
    <StackPanel Margin="24">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Choose a new password of 10 or more characters." />
        <Label Content="_Current password" Target="{Binding ElementName=CurrentPassword}" Padding="0,0,0,4" />
        <PasswordBox x:Name="CurrentPassword" Padding="6" Margin="0,0,0,12" />
        <Label Content="_New password (10+ characters)" Target="{Binding ElementName=NewPassword}" Padding="0,0,0,4" />
        <PasswordBox x:Name="NewPassword" Padding="6" Margin="0,0,0,12" />
        <Label Content="_Repeat new password" Target="{Binding ElementName=RepeatPassword}" Padding="0,0,0,4" />
        <PasswordBox x:Name="RepeatPassword" Padding="6" />
        <TextBlock x:Name="Error" Foreground="#C62828" TextWrapping="Wrap" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="_Save password" IsDefault="True" Click="Save_Click" Padding="14,6" />
        </StackPanel>
    </StackPanel>
</Window>
